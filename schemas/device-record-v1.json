{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeviceRecord",
  "description": "Deserialization of `DeviceRecord` requires `schema_version` and `schema_id`. Legacy NDJSON produced by rastreo v0.5 or earlier will fail to deserialize; consumers should tag legacy records with an explicit v0 marker before ingest.",
  "type": "object",
  "required": [
    "confidence",
    "identity_key",
    "last_seen",
    "schema_id",
    "schema_version",
    "signals"
  ],
  "properties": {
    "alt_ips": {
      "description": "Additional IPs the fuser correlated to the same identity — empty until a correlator fuser populates it.",
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "format": "ip"
      }
    },
    "confidence": {
      "type": "number",
      "format": "double"
    },
    "identity_key": {
      "$ref": "#/definitions/IdentityKey"
    },
    "last_seen": {
      "$ref": "#/definitions/SystemTime"
    },
    "mac": {
      "type": [
        "string",
        "null"
      ]
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ]
    },
    "mgmt_ip": {
      "type": [
        "string",
        "null"
      ],
      "format": "ip"
    },
    "platform": {
      "type": [
        "string",
        "null"
      ]
    },
    "possible_alias_of": {
      "description": "When set, this record is a medium-confidence alias of another record identified by the given `IdentityKey`.",
      "default": null,
      "anyOf": [
        {
          "$ref": "#/definitions/IdentityKey"
        },
        {
          "type": "null"
        }
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    },
    "scan_metadata": {
      "description": "Provenance stamped by the pipeline at scan entry.",
      "default": {
        "initiated_at": {
          "nanos_since_epoch": 0,
          "secs_since_epoch": 0
        },
        "scan_id": "",
        "scenario_name": null,
        "source_config_hash": null
      },
      "allOf": [
        {
          "$ref": "#/definitions/ScanMetadata"
        }
      ]
    },
    "schema_id": {
      "description": "Canonical schema URL; always `CURRENT_SCHEMA_ID` for records emitted by this build.",
      "type": "string"
    },
    "schema_version": {
      "description": "Schema version tag; always `CURRENT_SCHEMA_VERSION` for records emitted by this build.",
      "type": "string"
    },
    "signals": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Signal"
      }
    }
  },
  "definitions": {
    "IdentityKey": {
      "type": "string"
    },
    "ScanMetadata": {
      "description": "Per-scan provenance stamped on every emitted `DeviceRecord`. `scan_id` is a ULID; consumers can sort and correlate records by it.",
      "type": "object",
      "required": [
        "initiated_at",
        "scan_id"
      ],
      "properties": {
        "initiated_at": {
          "$ref": "#/definitions/SystemTime"
        },
        "scan_id": {
          "type": "string"
        },
        "scenario_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_config_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "Signal": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "OpenPort"
          ],
          "properties": {
            "OpenPort": {
              "type": "integer",
              "format": "uint16",
              "minimum": 0.0
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "HttpBanner"
          ],
          "properties": {
            "HttpBanner": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "SnmpSysObjectId"
          ],
          "properties": {
            "SnmpSysObjectId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "SnmpSysDescr"
          ],
          "properties": {
            "SnmpSysDescr": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "Mac"
          ],
          "properties": {
            "Mac": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "DnsHost"
          ],
          "properties": {
            "DnsHost": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "NtpBanner"
          ],
          "properties": {
            "NtpBanner": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "SipUserAgent"
          ],
          "properties": {
            "SipUserAgent": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "MemcachedVersion"
          ],
          "properties": {
            "MemcachedVersion": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "StunMappedAddress"
          ],
          "properties": {
            "StunMappedAddress": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "SnmpSysName"
          ],
          "properties": {
            "SnmpSysName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "SystemTime": {
      "type": "object",
      "required": [
        "nanos_since_epoch",
        "secs_since_epoch"
      ],
      "properties": {
        "nanos_since_epoch": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "secs_since_epoch": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        }
      }
    }
  }
}
