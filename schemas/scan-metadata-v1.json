{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScanMetadata",
  "description": "Per-scan provenance stamped on every emitted `DeviceRecord`. `scan_id` is a ULID; consumers can sort and correlate records by it.",
  "type": "object",
  "required": [
    "initiated_at",
    "scan_id"
  ],
  "properties": {
    "initiated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scan_id": {
      "type": "string"
    },
    "scenario_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_config_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
