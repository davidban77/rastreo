        {
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "file",
              "type": "string"
            }
          },
          "required": [
            "type",
            "path"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "memory",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "brokers": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "dead_letter": {
              "anyOf": [
                {
                  "$ref": "#/$defs/DeadLetterConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "flush_mode": {
              "$ref": "#/$defs/KafkaFlushMode",
              "default": {
                "threshold_bytes": 65536,
                "type": "batched"
              }
            },
            "links_topic": {
              "description": "Topic the `Link` record stream is produced to; defaults to `rastreo.discovery.links.v1`.",
              "type": [
                "string",
                "null"
              ]
            },
            "profiles_topic": {
              "description": "Topic the collection-profile stream is produced to; defaults to `rastreo.discovery.profiles.v1`.",
              "type": [
                "string",
                "null"
              ]
            },
            "retry": {
              "$ref": "#/$defs/SinkRetry",
              "default": {
                "backoff_initial_ms": 100,
                "backoff_max_ms": 2000,
                "max_attempts": 3
              }
            },
            "sasl": {
              "anyOf": [
                {
                  "$ref": "#/$defs/KafkaSasl"
                },
                {
                  "type": "null"
                }
              ]
            },
            "tls": {
              "anyOf": [
                {
                  "$ref": "#/$defs/KafkaTls"
                },
                {
                  "type": "null"
                }
              ]
            },
            "topic": {
              "type": "string"
            },
            "type": {
              "const": "kafka",
              "type": "string"
            }
          },
          "required": [
            "type",
            "brokers",
            "topic"
          ],
          "type": "object"
        },
        {
          "properties": {
            "credentials": {
              "$ref": "#/$defs/NatsCredentials",
              "default": {
                "type": "anonymous"
              }
            },
            "dead_letter": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NatsDeadLetterConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "flush_mode": {
              "$ref": "#/$defs/NatsFlushMode",
              "default": {
                "type": "per_record"
              }
            },
            "links_subject": {
              "description": "Subject the `Link` record stream is published to; defaults to `rastreo.discovery.links.v1`.",
              "type": [
                "string",
                "null"
              ]
            },
            "profiles_subject": {
              "description": "Subject the collection-profile stream is published to; defaults to `rastreo.discovery.profiles.v1`.",
              "type": [
                "string",
                "null"
              ]
            },
            "retry": {
              "$ref": "#/$defs/SinkRetry",
              "default": {
                "backoff_initial_ms": 100,
                "backoff_max_ms": 2000,
                "max_attempts": 3
              }
            },
            "servers": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "stream": {
              "type": "string"
            },
            "subject": {
              "type": "string"
            },
            "type": {
              "const": "nats",
              "type": "string"
            }
          },
          "required": [
            "type",
            "servers",
            "subject",
            "stream"
          ],
          "type": "object"
        }
      ]
    },
    "SinkRetry": {
      "description": "Bounded exponential-backoff retry policy for a sink's primary delivery.\n\n`max_attempts` counts total primary attempts: `1` disables retry (today's\nimmediate-DLQ behavior), `3` (the default) is the initial attempt plus two retries.",
      "properties": {
        "backoff_initial_ms": {
          "default": 100,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "backoff_max_ms": {
          "default": 2000,
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_attempts": {
          "default": 3,
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
