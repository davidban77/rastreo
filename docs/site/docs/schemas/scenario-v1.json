  "$id": "https://davidban77.github.io/rastreo/schemas/scenario-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "The YAML scenario file rastreo accepts via `rastreo discover --file`. Declares the shared\ndefaults and the list of discovery scenarios to run.",
  "properties": {
    "defaults": {
      "$ref": "#/$defs/BaseProbeConfig",
      "default": {
        "classifier": null,
        "encoder": null,
        "fuser": null,
        "max_concurrent": null,
        "name": null,
        "probe_rate": null,
        "retries": null,
        "sink": null,
        "timeout_ms": null
      },
      "description": "Defaults applied to every scenario unless the scenario overrides them."
    },
    "kind": {
      "$ref": "#/$defs/ScenarioKind"
    },
    "scenarios": {
      "items": {
        "$ref": "#/$defs/ScenarioEntry"
      },
      "type": "array"
    },
    "version": {
      "description": "Scenario file format version.",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "kind",
    "scenarios"
  ],
  "title": "ScenarioFile",
  "type": "object"
}
