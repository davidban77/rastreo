{
  "$id": "https://davidban77.github.io/rastreo/schemas/scan-metadata-v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Per-scan provenance stamped on every emitted `DeviceRecord`. `scan_id` is a ULID; consumers can sort and correlate records by it.",
  "properties": {
    "initiated_at": {
      "format": "date-time",
      "type": "string"
    },
    "scan_id": {
      "type": "string"
    },
    "scenario_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_config_hash": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "scan_id",
    "initiated_at"
  ],
  "title": "ScanMetadata",
  "type": "object"
}
