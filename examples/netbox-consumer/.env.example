# Kafka broker list, comma-separated host:port. Required.
KAFKA_BROKERS=localhost:9092

# Topic that rastreo publishes DeviceRecord events on.
KAFKA_TOPIC=rastreo.devices

# Consumer group. Use a distinct name for each independent consumer deployment.
KAFKA_GROUP_ID=rastreo-netbox-consumer

# Where to start when no committed offset exists for this group: earliest or latest.
KAFKA_AUTO_OFFSET_RESET=earliest

# Kafka poll timeout in milliseconds — how long each poll() call blocks waiting for a message.
POLL_TIMEOUT_MS=1000

# NetBox base URL (no trailing /api). Required.
NETBOX_URL=https://netbox.example.com

# NetBox API token with dcim.Device read+write. Required.
NETBOX_TOKEN=change-me

# Verify NetBox TLS certificate. Set to false only for local dev with self-signed certs.
NETBOX_VERIFY_TLS=true

# NetBox HTTP request timeout in seconds.
NETBOX_TIMEOUT_SECONDS=30

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# When true, the consumer logs the intended NetBox operation but does NOT call the NetBox API.
# Useful for validating the mapper against a live Kafka topic without touching NetBox.
DRY_RUN=false
