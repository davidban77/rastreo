# Kafka broker list, comma-separated host:port. Required.
KAFKA_BROKERS=localhost:9092

# Topic that rastreo publishes DeviceRecord events on.
KAFKA_TOPIC=rastreo.devices

# Consumer group. Use a distinct name for each independent consumer deployment.
KAFKA_GROUP_ID=rastreo-infrahub-consumer

# Where to start when no committed offset exists for this group: earliest or latest.
KAFKA_AUTO_OFFSET_RESET=earliest

# Kafka poll timeout in milliseconds — how long each poll() call blocks waiting for a message.
POLL_TIMEOUT_MS=1000

# Infrahub base URL. Required.
INFRAHUB_URL=https://infrahub.example.com

# Infrahub API token with read+write on RastreoDevice and branch merge permission. Required.
INFRAHUB_TOKEN=change-me

# Infrahub branch mutations land on. The consumer creates it from `main` at startup if missing.
# Set to `main` to write directly to the mainline (skip branch review).
INFRAHUB_BRANCH=rastreo-updates

# When true, merge INFRAHUB_BRANCH back to main after each successful upsert. Default false so
# ops teams review the accumulated changes via Infrahub's Proposed Changes UI.
INFRAHUB_AUTO_MERGE=false

# Infrahub HTTP request timeout in seconds.
INFRAHUB_TIMEOUT_SECONDS=30

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# When true, the consumer logs the intended Infrahub operation but does NOT call the Infrahub API.
# Useful for validating the mapper against a live Kafka topic without touching Infrahub.
DRY_RUN=false
