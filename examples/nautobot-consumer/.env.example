# Kafka broker list, comma-separated host:port. Required.
KAFKA_BROKERS=localhost:9092

# Topic that rastreo publishes DeviceRecord events on.
KAFKA_TOPIC=rastreo.devices

# Consumer group. Use a distinct name for each independent consumer deployment.
KAFKA_GROUP_ID=rastreo-nautobot-consumer

# Where to start when no committed offset exists for this group: earliest or latest.
KAFKA_AUTO_OFFSET_RESET=earliest

# Kafka poll timeout in milliseconds — how long each poll() call blocks waiting for a message.
POLL_TIMEOUT_MS=1000

# Nautobot base URL (no trailing /api). Required.
NAUTOBOT_URL=https://nautobot.example.com

# Nautobot API token with dcim.Device read+write. Required.
NAUTOBOT_TOKEN=change-me

# Verify Nautobot TLS certificate. Set to false only for local dev with self-signed certs.
NAUTOBOT_VERIFY_TLS=true

# Nautobot HTTP request timeout in seconds.
NAUTOBOT_TIMEOUT_SECONDS=30

# Default DeviceType name used when creating new devices. Required — Nautobot 2.x
# requires device_type on every Device, and this reference does not synthesise
# device types on the fly.
NAUTOBOT_DEFAULT_DEVICE_TYPE=generic-router

# Default Location name used when creating new devices. Required — Nautobot 2.x
# requires location on every Device.
NAUTOBOT_DEFAULT_LOCATION=discovery

# Default Status name applied to new devices. Nautobot ships an `Active` status
# by default; override only if your instance uses a different name.
NAUTOBOT_DEFAULT_DEVICE_STATUS=Active

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# When true, the consumer logs the intended Nautobot operation but does NOT call the Nautobot API.
# Useful for validating the mapper against a live Kafka topic without touching Nautobot.
DRY_RUN=false
